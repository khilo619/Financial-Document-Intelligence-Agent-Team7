# ==============================================================================
# PROJECT LEDGER: MASTER ENVIRONMENT CONFIGURATION TEMPLATE
# System: Financial Document Intelligence RAG Agent (MIA Team 7)
# 
# INSTRUCTIONS:
# 1. Copy this template to create your local .env file:
#    cp .env.example .env
# 2. Fill in your personal API keys below.
# 3. DO NOT COMMIT YOUR LOCAL .env FILE TO GIT!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Service Port Registry (Host Machine Ports)
# ------------------------------------------------------------------------------
UI_PORT=8000
ORCHESTRATOR_PORT=8001
DOC_PROCESSOR_PORT=8002
RETRIEVAL_PORT=8003
AGENT_PORT=8004
ANSWER_VALIDATOR_PORT=8005
EVAL_PORT=8006

# Infrastructure Ports
QDRANT_PORT=6333
LANGFUSE_PORT=3000

# ------------------------------------------------------------------------------
# 2. Service Network Hostnames
# (Use 'localhost' for local virtualenv runs, or service names in Docker network)
# ------------------------------------------------------------------------------
ORCHESTRATOR_HOST=localhost
DOC_PROCESSOR_HOST=localhost
RETRIEVAL_HOST=localhost
AGENT_HOST=localhost
ANSWER_VALIDATOR_HOST=localhost
EVAL_HOST=localhost
QDRANT_HOST=localhost
LANGFUSE_HOST=localhost

# ------------------------------------------------------------------------------
# 3. Observability & Tracing (Langfuse)
# ------------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-ledger-team7-public-sample
LANGFUSE_SECRET_KEY=sk-lf-ledger-team7-secret-sample
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_TRACING_ENABLED=true

# ------------------------------------------------------------------------------
# 4. Document Processing & OCR (IBM Docling)
# ------------------------------------------------------------------------------
# Mode: 'fast' (faster runtime, lower VRAM) or 'accurate' (heavy TableFormer)
DOCLING_TABLE_MODE=fast
DOCLING_IMAGES_SCALE=1.5
DATA_DIR=./data/processed_blocks

# ------------------------------------------------------------------------------
# 5. Deep Learning & Embedding Models
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
RERANKER_MODEL_NAME=BAAI/bge-reranker-large

# ------------------------------------------------------------------------------
# 6. LLM Brain & Provider Configuration
# ------------------------------------------------------------------------------
# Provider: 'gemini' (Free Google AI Studio cloud API) or 'ollama' (local)
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-3.6-flash
LLM_TEMPERATURE=0.0
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Optional Additional Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_TOKEN=

# ------------------------------------------------------------------------------
# 6. RAG Pipeline Hyperparameters
# ------------------------------------------------------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=30
TOP_N_RERANK=5
RRF_K_CONSTANT=60
